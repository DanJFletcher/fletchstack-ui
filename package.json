{
  "name": "fletchstack-ui",
  "version": "0.0.1",
  "description": "Themeable, accessible React components for Gatsby and Astro",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./button.css": "./dist/button.css",
    "./package.json": "./package.json",
    "./icon.css": "./dist/icon.css",
    "./card.css": "./dist/card.css",
    "./select.css": "./dist/select.css",
    "./text-input.css": "./dist/text-input.css",
    "./checkbox.css": "./dist/checkbox.css",
    "./form-group.css": "./dist/form-group.css",
    "./field.css": "./dist/field.css",
    "./textarea.css": "./dist/textarea.css",
    "./radio.css": "./dist/radio.css",
    "./link.css": "./dist/link.css",
    "./switch.css": "./dist/switch.css",
    "./spinner.css": "./dist/spinner.css",
    "./badge.css": "./dist/badge.css",
    "./separator.css": "./dist/separator.css",
    "./container.css": "./dist/container.css",
    "./stack.css": "./dist/stack.css",
    "./cluster.css": "./dist/cluster.css",
    "./simple-grid.css": "./dist/simple-grid.css",
    "./aspect-ratio.css": "./dist/aspect-ratio.css",
    "./section.css": "./dist/section.css",
    "./typography.css": "./dist/typography.css",
    "./button-group.css": "./dist/button-group.css",
    "./code-block.css": "./dist/code-block.css",
    "./avatar.css": "./dist/avatar.css",
    "./avatar-group.css": "./dist/avatar-group.css"
  },
  "files": [
    "dist",
    "tokens",
    "docs",
    "examples",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --coverage.enabled=false",
    "test:integration": "vitest run --project integration --coverage.enabled=false",
    "test:unit:coverage": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration:coverage": "vitest run --project integration --coverage --coverage.reportsDirectory=coverage/integration",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "node tests/browser-harness/run.mjs",
    "test:e2e:coverage": "playwright test --config=playwright.coverage.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report playwright-report/storybook",
    "storybook": "npm run tokens && storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "npm run tokens && storybook build --disable-telemetry",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "test:unit:affected": "node scripts/test-affected.mjs unit",
    "test:integration:affected": "node scripts/test-affected.mjs integration",
    "test:e2e:components": "playwright test --config=playwright.components.config.ts",
    "test:e2e:storybook": "playwright test --config=playwright.config.ts",
    "test:e2e:affected": "node tests/browser-harness/affected.mjs",
    "component:new": "node scripts/component.mjs new",
    "component:check": "node scripts/component.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.16.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "agent-guides-installer": "file:../../agent-guides/agent-guides-installer-0.1.0.tgz",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "31.0.0",
    "monocart-coverage-reports": "3.2.1",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "refractor": "5.0.0"
  }
}
