  {
    "source": "tests/e2e/components/code-block/CodeBlock.spec.ts",
    "title": "`${theme} literal code preserves whitespace and uses approved typography and AA paint`",
    "owner": "tests/browser-harness/specs/code-block/CodeBlock.spec.ts",
    "assertions": [
      "expect(await source.textContent()).toBe('\\n\\t<div>Markup & whitespace stay literal.</div>\\n<script>not executed</script>\\n');",
      "await expect(source).toHaveCSS('font-size', '14px');",
      "await expect(source).toHaveCSS('line-height', '21px');",
      "await expect(source).toHaveCSS('padding', '16px');",
      "expect(await source.evaluate(element => getComputedStyle(element).fontFamily)).toContain('monospace');",
      "expect(contrast(paint.text, paint.surface)).toBeGreaterThanOrEqual(4.5);",
      "expect(contrast(paint.muted, paint.header)).toBeGreaterThanOrEqual(4.5);",
      "expect(paint.radius).toBe(theme === 'luna' ? '12px' : '4px');",
      "await expect(page.getByRole('button')).toHaveCSS('background-color', theme === 'luna' ? 'rgb(199, 181, 255)' : 'rgb(255, 255, 255)');",
      "await expect(page.getByRole('button')).toHaveCSS('color', theme === 'luna' ? 'rgb(17, 19, 41)' : 'rgb(23, 35, 56)');",
      "await expect(source.locator('script')).toHaveCount(0);"
    ]
  },
  {
    "source": "tests/e2e/components/code-block/CodeBlock.spec.ts",
    "title": "`${theme} code scrolls by keyboard while wrap reflows without changing source`",
    "owner": "tests/browser-harness/specs/code-block/CodeBlock.spec.ts",
